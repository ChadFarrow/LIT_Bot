# LIT_Bot Configuration
# Copy this file to .env and fill in your values.
# On the VPS these live in /opt/bots/env/lit.env (mode 600), never in git.

# Required: Your LIT_Bot Nostr private key (generate with: noscl key-gen)
LIT_BOT_NSEC=nsec1...

# Optional: Port to run on (default: 3334)
PORT=3334

# Optional: Test mode (set to false for live posting)
TEST_MODE=false

# Optional: where rss-state.json lives. Defaults to the repo directory. The
# container sets this to /data, a bind mount, so the dedupe record survives image
# rebuilds -- losing it makes the bot repost every live notification it has seen.
STATE_DIR=

# IRC. In production IRC_SERVER is the shared ZNC container ("znc") on the compose
# bridge network, NOT ZeroNode directly -- ZNC holds one ZeroNode connection for all
# three bots. IRC_PASSWORD uses the clientid form so this bot is its own ZNC client.
IRC_ENABLED=true
IRC_SERVER=znc
IRC_PORT=6667
IRC_SECURE=false
IRC_NICKNAME=LIT_Bot
IRC_USERNAME=ircbots
IRC_PASSWORD=ircbots@lit/zeronode:<znc password>
IRC_CHANNELS="#BowlAfterBowl,#HomegrownHits,#DoerfelVerse,#SirLibre,#podcasting20,#greenroom"

# Optional: NickServ password. The LIT_Bot nick is registered to the ChadF account;
# setting this identifies on connect and ghosts a stale session holding the nick.
IRC_NICKSERV_PASSWORD=

# Optional: IRC disconnect delay in milliseconds (default: 5000)
IRC_DISCONNECT_DELAY=5000
